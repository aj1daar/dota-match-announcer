# Cloudflare Workers local development environment variables
# Copy this file to .dev.vars and fill in your actual values
# .dev.vars is gitignored and should never be committed

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
PANDASCORE_TOKEN=your_pandascore_api_token_here

# Optional: enables the admin/debug endpoints (/setup-webhook, /webhook-info, /bot-info, /poll-updates).
# Send it as "Authorization: Bearer <ADMIN_TOKEN>". Leave unset to keep them disabled.
# ADMIN_TOKEN=choose_a_long_random_value
